# How agents run: "auto" (API key if set, else Claude Code), "claude-code", or "api".
# With "claude-code" agents use your logged-in Claude Code (e.g. a Claude Pro/Max plan): no API key needed.
HARNESS_ENGINE=auto

# Only needed for the API engine.
# ANTHROPIC_API_KEY=sk-ant-...

# HARNESS_MODEL=claude-opus-5-5
# HARNESS_PORT=3456
# HARNESS_HOME=~/.agent-harness
# CLAUDE_BIN=claude

# External email agents (e.g. Instinct). Easier: Settings → Email in the UI.
# HARNESS_MAIL_USER=you@gmail.com
# HARNESS_MAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
