{
  "name": "agent-harness",
  "version": "0.2.0",
  "description": "A playground where teams of AI agents research, build, and talk to each other across your projects, shown as a live pixel-art town. Ships an MCP server for Claude Code / Claude Desktop.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-harness": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('src/server/public','dist/server/public',{recursive:true})\"",
    "start": "node dist/index.js serve",
    "mcp": "node dist/index.js mcp",
    "dev": "tsx src/index.ts serve",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "ai-agents",
    "multi-agent",
    "orchestrator",
    "anthropic",
    "claude"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
